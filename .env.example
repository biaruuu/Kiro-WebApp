# Streaming API (OPTIONAL)
# Description: Anivexa-compatible streaming API (https://github.com/walterwhite-69/Anivexa-API).
# Provides episode lists and sub/dub video sources, keyed by AniList id.
# Defaults to https://anibiartv-api.vercel.app when unset.
# VITE_STREAM_API="https://anibiartv-api.vercel.app"

# Episode Skip Times URL (OPTIONAL)
# Description: aniskip API. Skip times normally come from the streaming API itself.
# VITE_SKIP_TIMES="https://api.aniskip.com/"

# Server Port
# Description: The port number on which the server will listen (bun/express server only).
# Example: PORT=5173
PORT=5173

# TMDB (OPTIONAL, server-side only — set in Vercel, never prefix with VITE_)
# Description: powers hero title logos and HD backdrops. Use ONE of:
#   TMDB_API_KEY      the v3 API key
#   TMDB_READ_TOKEN   the v4 "API Read Access Token"
# Without it the hero falls back to the text title and the AniList banner.
# TMDB_API_KEY=""
