# Streaming API (server-side only — set in Vercel, never prefix with VITE_)
# Description: Anivexa-compatible streaming API. The browser never sees it: all
# requests go through /api/src, which renames providers and seals media URLs.
# Several instances can be listed, comma separated; their sources are merged.
# STREAM_API="https://api-one.example,https://api-two.example"
# SRC_SECRET: any long random string used to seal episode / media tokens.
# SRC_SECRET=""

# Episode Skip Times URL (OPTIONAL)
# Description: aniskip API. Skip times normally come from the streaming API itself.
# VITE_SKIP_TIMES="https://api.aniskip.com/"

# Server Port
# Description: The port number on which the server will listen (bun/express server only).
# Example: PORT=5173
PORT=5173

# TMDB (OPTIONAL, server-side only — set in Vercel, never prefix with VITE_)
# Description: powers hero title logos and HD backdrops. Use ONE of:
#   TMDB_API_KEY      the v3 API key
#   TMDB_READ_TOKEN   the v4 "API Read Access Token"
# Without it the hero falls back to the text title and the AniList banner.
# TMDB_API_KEY=""

# More providers: see docs/STREAM_API.md (host Anivexa-API on a normal server, not Vercel).
